# ═══════════════════════════════════════════════════════════════
# IT Agents Guardrails — Environment Template
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit .env — it is in .gitignore
# ALWAYS commit .env.example with REPLACE_ME placeholders
# ═══════════════════════════════════════════════════════════════

# ── Container / Compose ─────────────────────────────────────────
# Path on your HOST machine to mount as /workspace for scanning.
# Default is current directory (.) — override to scan another project.
WORKSPACE_PATH=.

# Default guardrails mode: check | fix | block
GUARDRAILS_MODE=check

# ── Platform ────────────────────────────────────────────────────
PLATFORM_ENV=development
PLATFORM_REGION=us-east-1

# ── Human Escalation (optional) ─────────────────────────────────
# Slack incoming webhook — receive escalation alerts in a channel
GUARDRAILS_SLACK_WEBHOOK=REPLACE_ME

# Generic webhook (e.g. Teams, PagerDuty, custom endpoint)
GUARDRAILS_WEBHOOK_URL=REPLACE_ME

# ── Agent Registry (optional overrides) ─────────────────────────
# Leave blank to use defaults from config/connective_config.yaml
AGENTS_PATH=data/agents/
AGENTS_CACHE_TTL_SECS=3600

# ── Guardrails profile ──────────────────────────────────────────
# standard | strict | relaxed | architect
# Overrides active_profile in config/guardrails_config.yaml
GUARDRAILS_PROFILE=standard

# ── CI/CD ────────────────────────────────────────────────────────
# Set to 'true' to treat warnings as errors in block mode
GUARDRAILS_STRICT_WARNINGS=false

# ── Finance Advisor project (optional) ──────────────────────────
# YouTube Data API v3 key — enables gather.py --youtube channel refresh
YOUTUBE_API_KEY=REPLACE_ME

# Alert emails (alerts.py --check / finance-alerts.yml workflow).
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your address,
# SMTP_PASSWORD=an App Password (myaccount.google.com/apppasswords), never your
# real password. ALERT_EMAIL = default recipient for alerts with no email set.
SMTP_HOST=REPLACE_ME
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
ALERT_EMAIL=REPLACE_ME

# ── Marketplace API ──────────────────────────────────────────────
# Port for the browser marketplace (http://localhost:8000)
MARKETPLACE_PORT=8000
# Public base URL shown in generated connector configs
MARKETPLACE_BASE_URL=http://localhost:8000
